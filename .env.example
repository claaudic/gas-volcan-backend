# Claves para "docker compose up". Copia este archivo como .env (en esta carpeta)
# y escribe valores reales. El .env NO se sube a GitHub.

# MySQL: clave del administrador (root) y del usuario "volcan" que usan los microservicios
MYSQL_ROOT_PASSWORD=escribe-una-clave-para-root
MYSQL_PASSWORD=escribe-una-clave-para-volcan

# Firma de los tokens de las personas: al menos 32 caracteres (openssl rand -base64 48)
JWT_SECRET=escribe-aqui-una-clave-larga-de-al-menos-32-caracteres

# Clave privada entre ms-pedidos y ms-catalogo para descontar stock: distinta de JWT_SECRET
INTERNAL_STOCK_JWT_SECRET=escribe-aqui-otra-clave-larga-distinta

# Opcional pero recomendado en la EC2: clave de las 5 cuentas de demostración
# (admin, despachadora, 2 repartidores y cliente). Vacía = las contraseñas de ejemplo del README.
# Solo se usa cuando la base de usuarios parte vacía.
# CLAVE_CUENTAS_DEMO=escribe-una-clave-propia

# Opcionales: desde qué página se usa la API (en la EC2, http://IP-PUBLICA) y puerto del Gateway
# CORS_ORIGENES=http://localhost:5173
# GATEWAY_PUERTO=8080

# Opcionales de la tienda: carpeta del repo tienda-react (por defecto ../tienda-react) y su puerto
# FRONTEND_CARPETA=../Proyecto_Volcan/tienda-react
# FRONTEND_PUERTO=80
