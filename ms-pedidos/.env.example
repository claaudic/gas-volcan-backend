# Copia este archivo como .env (en esta misma carpeta) y escribe las claves reales.
# El .env no se sube a GitHub.
MYSQL_PASSWORD=escribe-aqui-la-clave-del-usuario-volcan
# La MISMA clave JWT_SECRET de ms-usuarios (al menos 32 caracteres)
JWT_SECRET=escribe-aqui-la-misma-clave-de-ms-usuarios
# Obligatoria: clave independiente, compartida solo entre catalogo y pedidos.
# Configurar fuera de Git, al menos 32 bytes. No reutilizar JWT_SECRET.
INTERNAL_STOCK_JWT_SECRET=
