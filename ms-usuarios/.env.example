# Copia este archivo como .env (en esta misma carpeta) y escribe la clave real.
# El .env no se sube a GitHub.
MYSQL_PASSWORD=escribe-aqui-la-clave-del-usuario-volcan
# Clave para firmar los tokens: al menos 32 caracteres, la misma en los 3 microservicios.
# Se puede generar con: openssl rand -base64 48
JWT_SECRET=escribe-aqui-una-clave-larga-de-al-menos-32-caracteres
